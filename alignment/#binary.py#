import struct

def write_fortran_binary(filename, records):
    """
    Writes a Fortran-style binary file for Millepede II.

    Parameters:
        filename (str): Output binary file name.
        records (list of dict): List of records with keys:
            - "residual" (float)
            - "uncertainty" (float)
            - "local_derivatives" (list of float)
            - "global_labels" (list of int)
            - "global_derivatives" (list of float)
    """
    with open(filename, "wb") as f:
        for record_idx, record in enumerate(records):
            # Data fields
            residual = record["residual"]
            uncertainty = record["uncertainty"]
            local_derivatives = record["local_derivatives"]
            global_labels = record["global_labels"]
            global_derivatives = record["global_derivatives"]

            # Calculate the number of elements in the record
            num_local = len(local_derivatives)
            num_global = len(global_labels)

            # Calculate total record length
            record_length = 4 * (2 + num_local + 2 * num_global)  # (residual + uncertainty) + local + (labels + derivatives)

            # Debugging output
            print(f"Writing Record {record_idx + 1}:")
            print(f"  Record Length: {record_length} bytes")
            print(f"  Residual: {residual}, Uncertainty: {uncertainty}")
            print(f"  Local Derivatives: {local_derivatives}")
            print(f"  Global Labels: {global_labels}")
            print(f"  Global Derivatives: {global_derivatives}")

            # Write record length (header)
            f.write(struct.pack("i", record_length))

            # Write record data
            f.write(struct.pack("f", residual))
            f.write(struct.pack("f", uncertainty))
            for local in local_derivatives:
                f.write(struct.pack("f", local))
            for label, derivative in zip(global_labels, global_derivatives):
                f.write(struct.pack("i", label))
                f.write(struct.pack("f", derivative))

            # Write record length (footer)
            f.write(struct.pack("i", record_length))


