import struct

def write_mille_binary(filename, records):
    """
    Write a minimal Millepede binary file with a single record.
    
    Args:
        filename (str): The name of the binary file to write.
        records (list): List of dictionaries representing records to write.
    """
    with open(filename, "wb") as f:
        for record in records:
            # Extract record components
            residual = record["residual"]
            uncertainty = record["uncertainty"]
            local_derivatives = record["local_derivatives"]
            global_labels = record["global_labels"]
            global_derivatives = record["global_derivatives"]

            # Calculate the number of entries and record length
            nr = len(local_derivatives) + len(global_labels)
            record_length = 4 * (nr + 2)  # 4 bytes per entry
            
            # Fortran binary format requires length at the start and end of the record
            f.write(struct.pack("i", record_length))  # Record length prefix
            f.write(struct.pack("f", residual))       # Residual
            f.write(struct.pack("f", uncertainty))    # Uncertainty
            for ld in local_derivatives:
                f.write(struct.pack("f", ld))         # Local derivatives
            for label, gd in zip(global_labels, global_derivatives):
                f.write(struct.pack("i", label))      # Global labels
                f.write(struct.pack("f", gd))         # Global derivatives
            f.write(struct.pack("i", record_length))  # Record length suffix

