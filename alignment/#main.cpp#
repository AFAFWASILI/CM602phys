#include <fstream>
#include <vector>
#include <iostream>
#include <sstream>
#include <string>

// Define the structure to hold measurement data
struct Measurement {
    int measureNumber;
    int param1;
    int param2;
    int param3;
    float param4;
    float param5;
    std::vector<int> localIndices;
    std::vector<float> localValues;
    std::vector<int> globalIndices;
    std::vector<float> globalValues;
};

// Function to parse the text data and populate the measurements
std::vector<Measurement> parseTextData(const std::string& textData) {
    std::vector<Measurement> measurements;
    std::istringstream iss(textData);
    std::string line;
    Measurement measurement;
    int currentNR = 0;

    while (std::getline(iss, line)) {
        if (line.find("=== NR") != std::string::npos) {
            if (!measurement.localIndices.empty() || 
                !measurement.globalIndices.empty() || 
                !measurement.localValues.empty() || 
                !measurement.globalValues.empty()) {
                measurements.push_back(measurement);
                measurement = Measurement();
            }
            currentNR++;
            continue;
        }

        if (line.find("-g- meas.") != std::string::npos) {
            if (!measurement.localIndices.empty() || 
                !measurement.globalIndices.empty() || 
                !measurement.localValues.empty() || 
                !measurement.globalValues.empty()) {
                measurements.push_back(measurement);
                measurement = Measurement();
            }
            measurement.measureNumber = currentNR;
            std::istringstream issLine(line);
            std::string token;
            issLine >> token >> token >> measurement.param1 >> measurement.param2 >> measurement.param3 >> measurement.param4 >> measurement.param5;
        } else if (line.find("local   [") != std::string::npos) {
            line = line.substr(line.find('[') + 1);
            line = line.substr(0, line.find(']'));
            std::istringstream issLine(line);
            int localIndex;
            float localValue;
            while (issLine >> localIndex) {
                measurement.localIndices.push_back(localIndex);
            }
            while (issLine >> localValue) {
                measurement.localValues.push_back(localValue);
            }
        } else if (line.find("global  [") != std::string::npos) {
            line = line.substr(line.find('[') + 1);
            line = line.substr(0, line.find(']'));
            std::istringstream issLine(line);
            int globalIndex;
            float globalValue;
            while (issLine >> globalIndex) {
                measurement.globalIndices.push_back(globalIndex);
            }
            while (issLine >> globalValue) {
                measurement.globalValues.push_back(globalValue);
            }
        }
    }
    if (!measurement.localIndices.empty() || 
        !measurement.globalIndices.empty() || 
        !measurement.localValues.empty() || 
        !measurement.globalValues.empty()) {
        measurements.push_back(measurement);
    }
    return measurements;
}

// Function to write binary data to a file
void writeBinaryData(const std::string& filename, const std::vector<Measurement>& data) {
    std::ofstream outFile(filename, std::ios::binary);
    if (!outFile) {
        std::cerr << "Error opening file for writing: " << filename << std::endl;
        return;
    }

    for (const auto& record : data) {
        outFile.write(reinterpret_cast<const char*>(&record.measureNumber), sizeof(record.measureNumber));
        outFile.write(reinterpret_cast<const char*>(&record.param1), sizeof(record.param1));
        outFile.write(reinterpret_cast<const char*>(&record.param2), sizeof(record.param2));
        outFile.write(reinterpret_cast<const char*>(&record.param3), sizeof(record.param3));
        outFile.write(reinterpret_cast<const char*>(&record.param4), sizeof(record.param4));
        outFile.write(reinterpret_cast<const char*>(&record.param5), sizeof(record.param5));

        int localSize = record.localIndices.size();
        outFile.write(reinterpret_cast<const char*>(&localSize), sizeof(localSize));
        for (int i = 0; i < localSize; ++i) {
            outFile.write(reinterpret_cast<const char*>(&record.localIndices[i]), sizeof(record.localIndices[i]));
            outFile.write(reinterpret_cast<const char*>(&record.localValues[i]), sizeof(record.localValues[i]));
        }

        int globalSize = record.globalIndices.size();
        outFile.write(reinterpret_cast<const char*>(&globalSize), sizeof(globalSize));
        for (int i = 0; i < globalSize; ++i) {
            outFile.write(reinterpret_cast<const char*>(&record.globalIndices[i]), sizeof(record.globalIndices[i]));
            outFile.write(reinterpret_cast<const char*>(&record.globalValues[i]), sizeof(record.globalValues[i]));
        }
    }
    outFile.close();
}

